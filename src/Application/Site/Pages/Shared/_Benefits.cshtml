<section class="section" id="benefits" aria-labelledby="benefits-heading">
    <div class="container">
        <h2 id="benefits-heading">Built for .NET developers</h2>
        <p class="section-lead">Everything you need to trust a document number before you store it.</p>

        <div class="card-grid">
            <div class="card">
                <span class="card-icon">@Html.Icon("layers")</span>
                <h3>Multiple document types</h3>
                <p>Validators and generators for Portugal, Spain, France, Brazil, IBAN and major payment card schemes.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("shield")</span>
                <h3>Document validation</h3>
                <p>One call returns a clear result — format rules and check digits are handled for you.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("wand")</span>
                <h3>Document generation</h3>
                <p>Produce structurally valid sample numbers for tests and demos — including check digits.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("cpu")</span>
                <h3>.NET Native</h3>
                <p>Pure managed libraries built on .NET Standard — drop them into any modern .NET application.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("code")</span>
                <h3>Clean API</h3>
                <p>A consistent <code>Validate(value)</code> and <code>GenerateDocumentNumber()</code> shape across every package.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("branch")</span>
                <h3>Open Source</h3>
                <p>MIT licensed and developed in the open on GitHub — no hidden code, no vendor lock-in.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("cube")</span>
                <h3>Extensible architecture</h3>
                <p>Program against the shared <code>IDocumentNumberValidator</code> abstraction and swap document types freely.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("rocket")</span>
                <h3>Production ready</h3>
                <p>Versioned on NuGet, covered by test suites and ready for real workloads.</p>
            </div>
        </div>
    </div>
</section>
