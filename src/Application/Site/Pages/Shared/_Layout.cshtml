@using Site.Data
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="document validator, document number validator, nif validator, niss validator, citizen card validator, dotnet validation library, .net document validation, document number generator" />
    <link rel="canonical" href="@ViewData["Canonical"]" />

    @* Open Graph *@
    <meta property="og:site_name" content="Document Number Validator" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:url" content="@ViewData["Canonical"]" />
    <meta property="og:image" content="@(SiteInfo.BaseUrl)/og.png" />

    @* Twitter / X *@
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"]" />
    <meta name="twitter:description" content="@ViewData["Description"]" />
    <meta name="twitter:image" content="@(SiteInfo.BaseUrl)/og.png" />

    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';</script>
    <script type="application/ld+json">@Html.Raw(ViewData["JsonLd"])</script>

    @* Google tag (gtag.js) *@
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-972WK5CM96"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-972WK5CM96');
    </script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/">
                <svg class="brand-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 2l7 3v6c0 4.5-3 8.4-7 10-4-1.6-7-5.5-7-10V5l7-3z" stroke="currentColor" stroke-width="1.6" />
                    <path d="M8.5 12l2.4 2.4L15.8 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>Document Number Validator</span>
            </a>

            <nav class="site-nav" aria-label="Main navigation">
                <a href="/#supported">Validators</a>
                <a href="/#code-examples">Code examples</a>
                <a href="/#get-started">Get started</a>
                <a href="@SiteInfo.RepositoryUrl" rel="noopener">GitHub</a>
                <a href="@SiteInfo.NuGetProfileUrl" rel="noopener">NuGet</a>
            </nav>

            <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Switch color theme" title="Switch color theme">
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M21 13A9 9 0 1111 3a7 7 0 0010 10z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                </svg>
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
            </button>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <strong>Document Number Validator</strong>
                <span class="muted">Validate and generate document numbers in .NET</span>
                <span class="version-badge" title="Build version">v@(SiteInfo.Version)</span>
            </div>
            <nav class="footer-nav" aria-label="Footer">
                <a href="/">Home</a>
                <a href="@(SiteInfo.RepositoryUrl)/blob/develop/README.md" rel="noopener">Documentation</a>
                <a href="@SiteInfo.RepositoryUrl" rel="noopener">GitHub</a>
                <a href="@SiteInfo.NuGetProfileUrl" rel="noopener">NuGet</a>
                <a href="/privacy">Privacy Policy</a>
            </nav>
            <p class="muted footer-copy">Copyright © Fundisk Entertainment</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
