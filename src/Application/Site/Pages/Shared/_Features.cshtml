<section class="section alt" id="features" aria-labelledby="features-heading">
    <div class="container">
        <h2 id="features-heading">Library features</h2>
        <p class="section-lead">Small, focused packages that share one predictable design.</p>

        <div class="card-grid">
            <div class="card">
                <span class="card-icon">@Html.Icon("activity")</span>
                <h3>Validation Engine</h3>
                <p>Every validator applies the official format and check-digit rules for its document.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("wand")</span>
                <h3>Number Generators</h3>
                <p>Random, valid samples on demand — ideal for test data, fixtures and demos.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("cube")</span>
                <h3>Extensible Architecture</h3>
                <p>Small packages built on shared abstractions — take only what you need.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("pin")</span>
                <h3>Country Specific Rules</h3>
                <p>Rules maintained per country for Portugal, Spain, France and Brazil.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("zap")</span>
                <h3>High Quality Algorithms</h3>
                <p>Weighted, mod-97 and Luhn check-digit algorithms implemented to specification.</p>
            </div>
            <div class="card">
                <span class="card-icon">@Html.Icon("terminal")</span>
                <h3>Easy Integration</h3>
                <p>One <code>dotnet add package</code> command and a single method call — that's it.</p>
            </div>
        </div>
    </div>
</section>
