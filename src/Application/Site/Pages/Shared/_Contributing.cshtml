@using Site.Data
<section class="section alt" id="contributing" aria-labelledby="contributing-heading">
    <div class="container contributing">
        <h2 id="contributing-heading">Contributing</h2>
        <p class="section-lead">
            Document Number Validator is an open-source effort. New countries, new document types and
            better algorithms all start with a pull request.
        </p>
        <p class="contributing-badges">
            <span class="badge badge-ok">Open Source</span>
            <span class="badge badge-ok">MIT License</span>
            <span class="badge badge-ok">Pull Requests Welcome</span>
        </p>
        <a class="btn btn-secondary" href="@SiteInfo.RepositoryUrl" rel="noopener">View on GitHub</a>
    </div>
</section>
