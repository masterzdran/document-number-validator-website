@page "/Error"
@model Site.Pages.ErrorModel
<div class="container narrow center">
    <h1>Something went wrong</h1>
    <p class="section-lead">An unexpected error occurred while processing the request. Please try again.</p>
    <p class="hero-actions">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-secondary" href="@SiteInfo.WebsiteRepositoryUrl/issues" rel="noopener">Report an issue</a>
    </p>
</div>
