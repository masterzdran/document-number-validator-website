@page "/NotFound"
@model Site.Pages.NotFoundModel
<div class="container narrow center">
    <h1>404 — Page not found</h1>
    <p class="section-lead">The page you requested does not exist or the document type is not supported.</p>
    <p class="hero-actions">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-secondary" href="/#supported">Browse validators</a>
    </p>
</div>
