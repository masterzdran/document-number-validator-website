<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<PackageVersion>1.0.0</PackageVersion>
		<Version>1.0.0</Version>
		<!-- Footer shows "v1.0.0+build.247" when CI provides a build number -->
		<InformationalVersion Condition="'$(BUILD_BUILDNUMBER)' != ''">$(Version)+build.$(BUILD_BUILDNUMBER)</InformationalVersion>
		<InformationalVersion Condition="'$(GITHUB_RUN_NUMBER)' != ''">$(Version)+build.$(GITHUB_RUN_NUMBER)</InformationalVersion>
		<!-- No git-SHA suffix in the footer version -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<Authors>Nuno Cancelo</Authors>
        <PackageIcon>icon.64.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryBranch>main</RepositoryBranch>
        <RootNamespace>DocumentNumberValidatorWebsite</RootNamespace>
		<PackageProjectUrl>https://github.com/masterzdran/document-number-validator-website</PackageProjectUrl>
    	<RepositoryUrl>https://github.com/masterzdran/document-number-validator-website</RepositoryUrl>
	</PropertyGroup>
	<ItemGroup>
		<None Include="../../../icon.64.png" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="\"/>
	</ItemGroup>
</Project>